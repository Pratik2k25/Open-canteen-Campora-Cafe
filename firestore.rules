rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "devlopwithpratik@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    // --- Users Collection (PII Isolated & Owner Protected) ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == userId &&
        incoming().email is string &&
        incoming().email.size() <= 150 &&
        incoming().createdAt == request.time;
        
      allow update: if isOwner(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'preferences', 'updatedAt']);
        
      allow delete: if isAdmin();
    }

    // --- Categories Collection (Public Read, Admin Write) ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Menu Items Collection (Public Read, Admin Write) ---
    match /menuItems/{menuItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Carts Collection (Owner Read & Write) ---
    match /carts/{cartId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().serviceMode in ['dinein', 'takeaway', 'delivery'] &&
        incoming().items is list &&
        incoming().items.size() <= 50;
        
      allow update: if isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().serviceMode in ['dinein', 'takeaway', 'delivery'] &&
        incoming().items is list &&
        incoming().items.size() <= 50;
        
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // --- Orders Collection (Owner Read & Create, Lifecycle Gates) ---
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() &&
        isValidId(orderId) &&
        incoming().userId == request.auth.uid &&
        incoming().orderId == orderId &&
        incoming().serviceMode in ['dinein', 'takeaway', 'delivery'] &&
        incoming().items is list &&
        incoming().items.size() > 0 &&
        incoming().items.size() <= 50 &&
        incoming().subtotal is number &&
        incoming().subtotal >= 0 &&
        incoming().grandTotal is number &&
        incoming().grandTotal >= 0 &&
        incoming().orderStatus == 'placed' &&
        incoming().paymentStatus in ['pending', 'completed'] &&
        incoming().createdAt == request.time;
        
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          existing().userId == request.auth.uid &&
          existing().orderStatus == 'placed' &&
          incoming().orderStatus == 'cancelled' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'updatedAt']) &&
          incoming().updatedAt == request.time
        )
      );
      
      allow delete: if isAdmin();
    }

    // --- Addresses Collection (Owner Read & Write) ---
    match /addresses/{addressId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() &&
        isValidId(addressId) &&
        incoming().userId == request.auth.uid &&
        incoming().label is string &&
        incoming().label.size() <= 50 &&
        incoming().addressDetails is string &&
        incoming().addressDetails.size() <= 300;
        
      allow update: if isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['label', 'addressDetails', 'isDefault']);
        
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // --- App Settings (Public Read, Admin Write) ---
    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
